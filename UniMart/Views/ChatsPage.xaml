<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UniMart.Views.ChatsPage"
             BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="True">

    <Grid RowDefinitions="Auto,*"
          IgnoreSafeArea="True">

        <!-- HEADER -->
        <Border Grid.Row="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}"
                StrokeThickness="0"
                Padding="20,25,20,15">

            <Border.Shadow>
                <Shadow Brush="#000000"
                        Offset="0,2"
                        Radius="10"
                        Opacity="0.05"/>
            </Border.Shadow>

            <VerticalStackLayout Spacing="12">

                <Label Text="Messages"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"/>

                <Border BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray950}}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        Padding="15,0">

                    <Entry x:Name="SearchInput"
                           Placeholder="Search by item or name..."
                           FontSize="14"
                           HeightRequest="45"
                           TextChanged="OnSearchChanged"/>
                </Border>

            </VerticalStackLayout>
        </Border>

        <!-- CONTENT -->
        <Grid Grid.Row="1">

            <ActivityIndicator x:Name="LoadingSpinner"
                               IsRunning="True"
                               IsVisible="False"
                               Color="{StaticResource Primary}"
                               HeightRequest="40"
                               WidthRequest="40"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               ZIndex="10"/>

            <RefreshView x:Name="InboxRefreshView"
                         Refreshing="OnRefreshing"
                         RefreshColor="{StaticResource Primary}">

                <CollectionView x:Name="InboxList"
                                SelectionMode="Single"
                                SelectionChanged="OnChatSelected">

                    <!-- EMPTY VIEW -->
                    <CollectionView.EmptyView>

                        <VerticalStackLayout HorizontalOptions="Center"
                                             VerticalOptions="Center"
                                             Margin="0,100,0,0"
                                             Spacing="20">

                            <Image Source="empty_orders.png"
                                   HeightRequest="120"
                                   WidthRequest="120"
                                   Opacity="0.3"/>

                            <Label Text="No conversations yet"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Gray400}"
                                   HorizontalOptions="Center"/>

                        </VerticalStackLayout>

                    </CollectionView.EmptyView>

                    <!-- ITEM TEMPLATE -->
                    <CollectionView.ItemTemplate>

                        <DataTemplate>

                            <Grid Padding="20,15"
                                  ColumnDefinitions="60,*,Auto"
                                  ColumnSpacing="15">

                                <!-- IMAGE -->
                                <Border Grid.Column="0"
                                        WidthRequest="60"
                                        HeightRequest="60"
                                        StrokeShape="RoundRectangle 30"
                                        StrokeThickness="0">

                                    <Image Source="{Binding ListingImage, FallbackValue=placeholder.png}"
                                           Aspect="AspectFill"
                                           BackgroundColor="{StaticResource Gray100}"/>

                                </Border>

                                <!-- CENTER -->
                                <VerticalStackLayout Grid.Column="1"
                                                     VerticalOptions="Center"
                                                     Spacing="4">

                                    <HorizontalStackLayout Spacing="8">

                                        <Label Text="{Binding PartnerName}"
                                               FontAttributes="Bold"
                                               FontSize="16"
                                               LineBreakMode="TailTruncation"
                                               TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"/>

                                        <Border Padding="6,2"
                                                StrokeShape="RoundRectangle 4"
                                                BackgroundColor="{Binding RoleBgColor}"
                                                StrokeThickness="0"
                                                VerticalOptions="Center">

                                            <Label Text="{Binding RoleText}"
                                                   FontSize="8"
                                                   FontAttributes="Bold"
                                                   TextColor="{Binding RoleTextColor}"/>

                                        </Border>

                                    </HorizontalStackLayout>

                                    <Label Text="{Binding ListingTitle}"
                                           FontSize="12"
                                           TextColor="{StaticResource Gray500}"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="1"/>

                                    <Label Text="{Binding LastMessage}"
                                           FontSize="14"
                                           TextColor="{Binding MessageTextColor}"
                                           FontAttributes="{Binding MessageFontWeight}"
                                           MaxLines="1"
                                           LineBreakMode="TailTruncation"/>

                                </VerticalStackLayout>

                                <!-- RIGHT -->
                                <VerticalStackLayout Grid.Column="2"
                                                     VerticalOptions="Center"
                                                     HorizontalOptions="End"
                                                     Spacing="8">

                                    <Label Text="{Binding TimeAgo}"
                                           FontSize="11"
                                           TextColor="{Binding MessageTextColor}"
                                           HorizontalOptions="End"/>

                                    <HorizontalStackLayout HorizontalOptions="End"
                                                           Spacing="6">

                                        <Border Padding="8,2"
                                                StrokeShape="RoundRectangle 4"
                                                BackgroundColor="{Binding StatusBgColor}"
                                                StrokeThickness="0"
                                                VerticalOptions="Center">

                                            <Label Text="{Binding DisplayStatus}"
                                                   FontSize="8"
                                                   FontAttributes="Bold"
                                                   TextColor="{Binding StatusTextColor}"/>

                                        </Border>

                                        <Border BackgroundColor="#DC3545"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 10"
                                                HeightRequest="20"
                                                MinimumWidthRequest="20"
                                                Padding="6,0"
                                                VerticalOptions="Center"
                                                IsVisible="{Binding HasUnreadMessages}">

                                            <Label Text="{Binding UnreadCount}"
                                                   TextColor="White"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"/>

                                        </Border>

                                    </HorizontalStackLayout>

                                </VerticalStackLayout>

                            </Grid>

                        </DataTemplate>

                    </CollectionView.ItemTemplate>

                </CollectionView>

            </RefreshView>

        </Grid>

    </Grid>

</ContentPage>