<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UniMart.Views.WalletPage"
             BackgroundColor="#FFFFFF"
             Shell.NavBarIsVisible="False">

    <Grid>
        <Grid RowDefinitions="Auto, *">
            <Border Grid.Row="0" BackgroundColor="White" StrokeThickness="0" Padding="20,15,20,15">
                <Label Text="My Wallet" FontSize="20" FontAttributes="Bold" TextColor="#1A1A1A" HorizontalOptions="Center"/>
            </Border>

            <ScrollView x:Name="WalletScrollView" Grid.Row="1" VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Padding="20" Spacing="25">

                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 24" HeightRequest="210" Padding="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0056B3" Offset="0.1" />
                                <GradientStop Color="#007BFF" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Shadow>
                            <Shadow Brush="#0056B3" Offset="0,10" Radius="20" Opacity="0.3" />
                        </Border.Shadow>

                        <Grid Padding="25" RowDefinitions="Auto, *, Auto">
                            <Label Text="Available Balance" TextColor="#B0D4FF" FontSize="13" FontAttributes="Bold" CharacterSpacing="1"/>

                            <HorizontalStackLayout Grid.Row="1" VerticalOptions="Center" Spacing="8">
                                <Label Text="RM" TextColor="White" FontSize="22" FontAttributes="Bold" VerticalOptions="Center" Margin="0,8,0,0"/>
                                <Label x:Name="BalanceLabel" Text="0.00" TextColor="White" FontSize="46" FontAttributes="Bold"/>
                            </HorizontalStackLayout>

                            <Border Grid.Row="2" BackgroundColor="#20FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 8" HorizontalOptions="Start" Padding="12,6">
                                <Label x:Name="EscrowLabel" Text="Locked in Escrow: RM 0.00" TextColor="White" FontSize="12" FontAttributes="Bold"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                        <Button Grid.Column="0" Text="Withdraw" Clicked="OnWithdrawClicked" BackgroundColor="#F8F9FA" TextColor="#1A1A1A" CornerRadius="12" HeightRequest="52" BorderColor="#E9ECEF" BorderWidth="1"/>
                        <Button Grid.Column="1" Text="Pay / Scan" BackgroundColor="#1A1A1A" TextColor="White" CornerRadius="12" HeightRequest="52" FontAttributes="Bold"/>
                    </Grid>

                    <VerticalStackLayout Spacing="15">
                        <Label Text="Top Up Funds" FontSize="18" FontAttributes="Bold" TextColor="#1A1A1A"/>

                        <Border Stroke="#F1F3F5" StrokeThickness="2" StrokeShape="RoundRectangle 16" BackgroundColor="#F8F9FA" Padding="20,10">
                            <Grid ColumnDefinitions="Auto, *">
                                <Label Text="RM" FontSize="22" FontAttributes="Bold" TextColor="#0056B3" VerticalOptions="Center" Margin="0,0,15,0"/>
                                <Entry x:Name="AmountEntry" Grid.Column="1" Placeholder="0.00" Keyboard="Numeric" FontSize="24" FontAttributes="Bold" TextColor="#1A1A1A" Focused="OnAmountFocused" Unfocused="OnAmountUnfocused" Completed="OnAmountCompleted"/>
                            </Grid>
                        </Border>

                        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                            <Button Text="+10" Clicked="OnQuickAmountClicked" CommandParameter="10" WidthRequest="75" BackgroundColor="#E7F1FF" TextColor="#0056B3" CornerRadius="20"/>
                            <Button Text="+50" Clicked="OnQuickAmountClicked" CommandParameter="50" WidthRequest="75" BackgroundColor="#E7F1FF" TextColor="#0056B3" CornerRadius="20"/>
                            <Button Text="+100" Clicked="OnQuickAmountClicked" CommandParameter="100" WidthRequest="75" BackgroundColor="#E7F1FF" TextColor="#0056B3" CornerRadius="20"/>
                        </HorizontalStackLayout>

                        <Button x:Name="CheckoutButton" Text="Add Funds via Stripe" Clicked="OnCheckoutClicked" BackgroundColor="#0056B3" TextColor="White" FontAttributes="Bold" CornerRadius="16" HeightRequest="60"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="15" Margin="0,0,0,20">
                        <Label Text="Transaction History" FontSize="18" FontAttributes="Bold" TextColor="#1A1A1A"/>
                        <CollectionView x:Name="TransactionsList">
                            <CollectionView.EmptyView>
                                <VerticalStackLayout Spacing="10" Padding="40">
                                    <Label Text="💸" FontSize="44" HorizontalOptions="Center"/>
                                    <Label Text="No activity yet" HorizontalOptions="Center" TextColor="#ADB5BD" FontAttributes="Bold"/>
                                </VerticalStackLayout>
                            </CollectionView.EmptyView>

                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout>
                                        <Grid ColumnDefinitions="*, Auto" Padding="0,16">
                                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="4">
                                                <Label Text="{Binding Description}" FontAttributes="Bold" TextColor="#1A1A1A" FontSize="14" LineBreakMode="WordWrap"/>
                                                <Label Text="{Binding LocalDisplayDate}" TextColor="#868E96" FontSize="11"/>
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1" Text="{Binding DisplayAmount}" TextColor="{Binding AmountColor}" FontAttributes="Bold" FontSize="16" VerticalOptions="Center" Margin="10,0,0,0"/>
                                        </Grid>
                                        <BoxView HeightRequest="1" Color="#F1F3F5" Margin="0,0,0,0"/>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>

                        </CollectionView>
                    </VerticalStackLayout>

                    <ContentView x:Name="KeyboardSpacer" HeightRequest="0" />

                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <Grid x:Name="CustomAlertBox" ZIndex="200" VerticalOptions="Start" HorizontalOptions="Center" Margin="0,20,0,0" TranslationY="-150">
            <Border x:Name="AlertBorder" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="#198754" Padding="20,15" WidthRequest="340">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="12" Opacity="0.15" />
                </Border.Shadow>
                <HorizontalStackLayout Spacing="15">
                    <Label x:Name="AlertIcon" Text="✓" FontSize="20" FontAttributes="Bold" TextColor="White" VerticalOptions="Center"/>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                        <Label x:Name="AlertTitle" Text="Success" FontSize="14" FontAttributes="Bold" TextColor="White"/>
                        <Label x:Name="AlertMessage" Text="Your item is live!" FontSize="12" TextColor="White" Opacity="0.9"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>